# Required AI provider
LLM_PROVIDER=grok
XAI_API_KEY=replace-me
SUOITIEN_GROK_MODEL=grok-4-fast-reasoning

# Public website embedding
CORS_ORIGINS=https://suoitien.vn,https://www.suoitien.vn
RATE_LIMIT_PER_MIN=20

# Set only when a trusted reverse proxy is configured.
TRUST_PROXY=0
# FORWARDED_ALLOW_IPS=127.0.0.1

# Protected maintenance endpoints
ADMIN_KEY=replace-with-a-long-random-value
CONTENT_WEBHOOK_SECRET=replace-with-a-long-random-value

# Optional integrations
OWM_API_KEY=
FB_VERIFY_TOKEN=
FB_APP_SECRET=
ZALO_APP_ID=
ZALO_APP_SECRET=

# Runtime tuning
EMBED_DEVICE=cpu
TORCH_NUM_THREADS=4
SUOITIEN_LLM_TIMEOUT=25
SUOITIEN_LEARN_SAMPLE_RATE=0.1
